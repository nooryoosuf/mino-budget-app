# No secrets required for the local-first build.
# If cloud sync is added later, copy to .env (git-ignored) and fill in:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# NEVER put the service-role key in this file or any client code.

# Future Mino LLM provider (NOT used — Mino runs fully on-device today).
# Only needed if a server-side model is ever wired behind the provider seam:
# MINO_MODEL_URL=https://your-model-endpoint/v1
# MINO_MODEL_KEY=server-side-only-never-client
